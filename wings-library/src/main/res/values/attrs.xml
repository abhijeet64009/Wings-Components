<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="ProgressButton">
        <attr name="buttonColor" format="color"/>
        <attr name="buttonHeight" format="dimension"/>

        <attr name="buttonText" format="string"/>
        <attr name="buttonTextColor" format="color"/>
        <attr name="buttonTextSize" format="dimension"/>

        <attr name="delayTime" format="integer"/>
        <attr name="cornerRadius" format="dimension"/>

        <!-- Progress indicator customization -->
        <attr name="progressSize" format="dimension"/>
        <attr name="progressTrackColor" format="color"/>
        <attr name="progressIndicatorColor" format="color"/>
        <attr name="progressTrackThickness" format="dimension"/>

        <!-- 0=start | 1=middle | 2=end -->
        <attr name="executeAt">
            <enum name="start" value="0"/>
            <enum name="middle" value="1"/>
            <enum name="end" value="2"/>
        </attr>
    </declare-styleable>

    <declare-styleable name="NumberPicker">
        <attr name="decreaseButtonTint" format="color"/>
        <attr name="increaseButtonTint" format="color"/>
        <attr name="decreaseButtonIconTint" format="color"/>
        <attr name="increaseButtonIconTint" format="color"/>

        <attr name="buttonSize" format="dimension"/>
        <attr name="pickerHeight" format="dimension"/>
        <attr name="pickerWidth" format="dimension"/>
        <attr name="countTextStyle" format="enum">
            <enum name="normal" value="0"/>
            <enum name="bold" value="1"/>
            <enum name="italic" value="2"/>
            <enum name="bold_italic" value="3"/>
        </attr>
        <attr name="countTextColor" format="color"/>
        <attr name="countTextSize" format="dimension"/>
        <attr name="countTextFontFamily" format="reference"/>

        <attr name="count" format="integer"/>
        <attr name="minCount" format="integer"/>
        <attr name="maxCount" format="integer"/>
        <attr name="countJumpInterval" format="integer"/>
    </declare-styleable>
</resources>